// Tests.xcconfig — unit tests, hosted in the app so the keychain has the app's entitlements.

PRODUCT_NAME = QeetIDTests
PRODUCT_BUNDLE_IDENTIFIER = $(QEETID_APP_BUNDLE_IDENTIFIER).tests
GENERATE_INFOPLIST_FILE = YES
TEST_HOST = $(BUILT_PRODUCTS_DIR)/QeetID.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/QeetID
BUNDLE_LOADER = $(TEST_HOST)
INFOPLIST_PREPROCESS = NO
