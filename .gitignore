# macOS
.DS_Store

# Xcode: per-user state and build output
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
DerivedData/
build/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
*.xcresult
*.xcarchive

# Swift Package Manager: the resolved versions are committed (Package.resolved); checkouts are not
.build/
.swiftpm/
Packages/
SourcePackages/

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Local signing and secrets: never committed
Configs/Signing.xcconfig.local
*.xcconfig.local
*.p8
*.p12
*.cer
*.mobileprovision
*.provisionprofile
*.pem
*.key
.env
.env.*
