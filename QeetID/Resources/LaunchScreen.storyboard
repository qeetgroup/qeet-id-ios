<?xml version="1.0" encoding="UTF-8"?>
<!--
  Launch, as the mockup draws it on iOS (qeet-mockups, products/qeet-id, 01 Launch): the app icon at 112 pt in the
  middle of the screen, and "from Qeet Group" with its foot 48 pt above the safe area, on the canvas, in light and dark.
  The images come from Scripts/generate-launch-screen.py.
-->
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="25408" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="QiL-au-nch">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="25408"/>
        <capability name="Named colors" minToolsVersion="9.0"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="QiS-ce-ne1">
            <objects>
                <viewController id="QiL-au-nch" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="QiV-ie-w01">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" image="LaunchMark" translatesAutoresizingMaskIntoConstraints="NO" id="QiM-ar-k01">
                                <rect key="frame" x="140.5" y="370" width="112" height="112"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="112" id="QiC-mw-001"/>
                                    <constraint firstAttribute="height" constant="112" id="QiC-mh-001"/>
                                </constraints>
                            </imageView>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" image="LaunchBranding" translatesAutoresizingMaskIntoConstraints="NO" id="QiB-rn-d01">
                                <rect key="frame" x="116.5" y="726" width="160" height="44"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="160" id="QiC-bw-001"/>
                                    <constraint firstAttribute="height" constant="44" id="QiC-bh-001"/>
                                </constraints>
                            </imageView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="QiG-sa-fe1"/>
                        <color key="backgroundColor" name="LaunchBackground"/>
                        <constraints>
                            <constraint firstItem="QiM-ar-k01" firstAttribute="centerX" secondItem="QiV-ie-w01" secondAttribute="centerX" id="QiC-mx-001"/>
                            <constraint firstItem="QiM-ar-k01" firstAttribute="centerY" secondItem="QiV-ie-w01" secondAttribute="centerY" id="QiC-my-001"/>
                            <constraint firstItem="QiB-rn-d01" firstAttribute="centerX" secondItem="QiV-ie-w01" secondAttribute="centerX" id="QiC-bx-001"/>
                            <constraint firstItem="QiG-sa-fe1" firstAttribute="bottom" secondItem="QiB-rn-d01" secondAttribute="bottom" constant="48" id="QiC-by-001"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="QiF-rs-tR1" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="53" y="375"/>
        </scene>
    </scenes>
    <resources>
        <image name="LaunchBranding" width="160" height="44"/>
